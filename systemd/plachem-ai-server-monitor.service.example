[Unit]
Description=PLACHEM AI Server Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plachem-monitor
WorkingDirectory=/opt/plachem-ai-server-monitor
Environment=PLACHEM_MONITOR_SERVER_NAME=PLACHEM-AI-01
Environment=PLACHEM_MONITOR_FOLDERS=/tmp
Environment=PYTHONPATH=/opt/plachem-ai-server-monitor/.deps
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
